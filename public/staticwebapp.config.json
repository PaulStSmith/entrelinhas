{
  "routes": [
    {
      "route": "/assets/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "route": "/index.html",
      "headers": { "Cache-Control": "no-cache" }
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
